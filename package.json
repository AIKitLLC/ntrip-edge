{
  "name": "ntrip-edge",
  "version": "1.0.0",
  "description": "Open-source NTRIP v1.0/v2.0 Caster, RTCM 3.x Encoder/Decoder, GNSS RTK Simulator & Interactive Playground on Cloudflare Workers",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "deploy:dev": "wrangler deploy --env dev",
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ntrip",
    "rtcm3",
    "gnss",
    "rtk",
    "nmea",
    "vrs",
    "cloudflare-workers",
    "edge-computing",
    "hono",
    "simulator"
  ],
  "author": "AIKitLLC",
  "license": "MIT",
  "dependencies": {
    "hono": "^4.7.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@types/node": "^22.20.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "wrangler": "^4.142.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AIKitLLC/ntrip-edge.git"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.33.0"
}
